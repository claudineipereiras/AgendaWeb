# ==============================================================================
# AgendaWeb Root Router (Hostinger Multi-Strategy Deployment Support)
# ==============================================================================

Options -Indexes
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Pass Authorization Header to PHP on LiteSpeed/Apache
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
  RewriteCond %{HTTP:Authorization} ^(.*)
  RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Block direct access to Docs, Git, IDE and archive files
  RewriteRule ^(Docs|docs|\.git|\.antigravity)/ - [F,L]
  RewriteRule \.(env.*|sql|db|sqlite|log|sh|bak|zip)$ - [F,L]

  # If deployed with the Application/ subdirectory structure in public_html,
  # transparently route incoming root requests into Application/
  RewriteCond %{DOCUMENT_ROOT}/Application/index.html -f
  RewriteCond %{REQUEST_URI} !^/Application/
  RewriteRule ^(.*)$ Application/$1 [L,QSA]
</IfModule>
